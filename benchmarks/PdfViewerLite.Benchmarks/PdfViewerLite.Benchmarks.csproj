<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Description>Allocation and throughput benchmarks for PdfViewerLite.</Description>
    <UsesTesseractNative>true</UsesTesseractNative>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PdfViewerLite.Core\PdfViewerLite.Core.csproj" />
    <ProjectReference Include="..\..\src\PdfViewerLite.Skia\PdfViewerLite.Skia.csproj" />
    <ProjectReference Include="..\..\src\PdfViewerLite.Platform.Cups\PdfViewerLite.Platform.Cups.csproj" />
    <ProjectReference Include="..\..\src\PdfViewerLite.Platform.Linux\PdfViewerLite.Platform.Linux.csproj" />
    <ProjectReference Include="..\..\src\PdfViewerLite.Pdfium\PdfViewerLite.Pdfium.csproj" />
    <ProjectReference Include="..\..\src\PdfViewerLite.Ocr\PdfViewerLite.Ocr.csproj" />
    <ProjectReference Include="..\..\src\PdfViewerLite.Speech\PdfViewerLite.Speech.csproj" />
    <ProjectReference Include="..\..\src\PdfViewerLite.Http\PdfViewerLite.Http.csproj" />
    <ProjectReference Include="..\..\tests\PdfViewerLite.TestAssets\PdfViewerLite.TestAssets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\PdfViewerLite.App\Services\DesktopBackend.cs" Link="DesktopBackend.cs" />
    <Compile Include="..\..\src\PdfViewerLite.App\Views\FocusAnnouncementRepair.cs" Link="FocusAnnouncementRepair.cs" />
  </ItemGroup>
</Project>
