<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <Description>Modern SkiaSharp 4 rendering engine for Hyper PDF Viewer.</Description>
    <RootNamespace>PdfViewerLite.Skia</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="HarfBuzzSharp" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="pdfviewerlite" />
    <InternalsVisibleTo Include="PdfViewerLite.App.Tests" />
    <InternalsVisibleTo Include="PdfViewerLite.Benchmarks" />
  </ItemGroup>

  <!-- The renderer implements platform contracts omitted from Avalonia's public reference assemblies. -->
  <Target Name="UseAvaloniaImplementationAssemblies" AfterTargets="FindReferenceAssembliesForReferences" BeforeTargets="CoreCompile">
    <ItemGroup>
      <AvaloniaRendererReference Include="@(ReferencePathWithRefAssemblies)" Condition="'%(NuGetPackageId)' == 'Avalonia'" />
      <ReferencePathWithRefAssemblies Remove="@(AvaloniaRendererReference)" />
      <ReferencePathWithRefAssemblies Include="@(AvaloniaRendererReference->Replace('\', '/')->Replace('/ref/', '/lib/'))" />
    </ItemGroup>
  </Target>
</Project>
