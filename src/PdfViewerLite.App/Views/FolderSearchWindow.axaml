<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PdfViewerLite.App.Views.FolderSearchWindow"
        Title="Search in Folder" Width="720" Height="560" MinWidth="480" MinHeight="360" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackground}">
  <!-- Layout only: bindings are made in code (FolderSearchWindow.axaml.cs). -->
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="10">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="Folder" Width="70" VerticalAlignment="Center" />
        <Button DockPanel.Dock="Right" x:Name="ChooseFolderButton" Content="_Choose…" Margin="8,0,0,0" AutomationProperties.Name="Choose folder" />
        <TextBox x:Name="FolderBox" AutomationProperties.Name="Folder to search" />
      </DockPanel>
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="Find" Width="70" VerticalAlignment="Center" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
          <Button x:Name="SearchButton" Content="_Search" IsDefault="True" AutomationProperties.Name="Search the folder" />
          <Button x:Name="StopButton" Content="S_top" AutomationProperties.Name="Stop searching" />
        </StackPanel>
        <TextBox x:Name="QueryBox" AutomationProperties.Name="Words to find" />
      </DockPanel>
      <StackPanel Orientation="Horizontal" Spacing="16" Margin="70,0,0,0">
        <CheckBox x:Name="MatchCaseBox" Content="Match _case" />
        <CheckBox x:Name="WholeWordBox" Content="_Whole words" />
        <CheckBox x:Name="SubfoldersBox" Content="Include sub_folders" />
      </StackPanel>
      <TextBlock x:Name="StatusText" Classes="secondary" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
    </StackPanel>
    <Button DockPanel.Dock="Bottom" x:Name="CloseButton" Content="Close" IsCancel="True" HorizontalAlignment="Right" Margin="0,12,0,0" />
    <ListBox x:Name="ResultList" Margin="0,12,0,0" AutomationProperties.Name="Results" />
  </DockPanel>
</Window>
