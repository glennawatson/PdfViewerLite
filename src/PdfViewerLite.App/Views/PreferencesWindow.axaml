<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PdfViewerLite.App.Views.PreferencesWindow"
        Title="Preferences"
        Width="520" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackground}">
  <!-- Changes apply as soon as they are chosen; nothing else moves. -->
  <StackPanel Margin="20" Spacing="16">
    <TextBlock Classes="secondary" TextWrapping="Wrap"
               Text="Changes apply straight away and are kept for next time." />
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="16">
      <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Colour scheme" />
      <ComboBox AutomationProperties.Name="Colour scheme" x:Name="SchemeBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" />
      <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="PDF page colour" />
      <ComboBox AutomationProperties.Name="PDF page colour" x:Name="PageToneBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ToolTip.Tip="Changes the pages on screen. Printed pages keep their document colours." />
      <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Tool bar" />
      <ComboBox AutomationProperties.Name="Tool bar" x:Name="ToolbarBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" />
      <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="When a file changes on disk" />
      <ComboBox AutomationProperties.Name="When a file changes on disk" x:Name="FileChangeBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" />
      <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Motion" />
      <ComboBox AutomationProperties.Name="Motion" x:Name="MotionBox" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch" />
      <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Text cursor" />
      <ComboBox AutomationProperties.Name="Text cursor" x:Name="CaretBox" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Stretch" />
      <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="Interface text size" />
      <ComboBox AutomationProperties.Name="Interface text size" x:Name="FontSizeBox" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Stretch" />
      <TextBlock Grid.Row="7" VerticalAlignment="Center" Text="Opening zoom" />
      <ComboBox AutomationProperties.Name="Opening zoom" x:Name="OpeningZoomBox" Grid.Row="7" Grid.Column="1" HorizontalAlignment="Stretch" ToolTip.Tip="Used for new documents. Fit page shows the whole page. Fit width fills the available width." />
    </Grid>
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="16">
      <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Read Aloud voice" />
      <ComboBox AutomationProperties.Name="Read Aloud voice" x:Name="SpeechEngineBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" />
      <TextBlock x:Name="AzureKeyLabel" Grid.Row="1" VerticalAlignment="Center" Text="Azure Speech key" />
      <TextBox AutomationProperties.Name="Azure Speech key" x:Name="AzureKeyBox" Grid.Row="1" Grid.Column="1" PasswordChar="•" PlaceholderText="Key 1 or Key 2 from your Speech resource" />
      <TextBlock x:Name="AzureRegionLabel" Grid.Row="2" VerticalAlignment="Center" Text="Azure region" />
      <TextBox AutomationProperties.Name="Azure region" x:Name="AzureRegionBox" Grid.Row="2" Grid.Column="1" PlaceholderText="For example uksouth or eastus" />
      <TextBlock x:Name="SpeechNote" Grid.Row="3" Grid.ColumnSpan="2" Classes="secondary" TextWrapping="Wrap" />
    </Grid>
    <!-- Text recognition languages: tick the languages to read; each row downloads or removes its own pack. -->
    <StackPanel Spacing="6">
      <TextBlock Text="Text recognition languages" />
      <TextBlock x:Name="OcrNote" Classes="secondary" TextWrapping="Wrap" />
      <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="OcrLanguageList" AutomationProperties.Name="Text recognition languages" />
      </ScrollViewer>
      <DockPanel>
        <Button x:Name="StopLanguageDownloadButton" DockPanel.Dock="Right" Content="Stop Download"
                AutomationProperties.Name="Stop download"
                AutomationProperties.HelpText="Stops the language pack download. Packs already finished are kept."
                ToolTip.Tip="Stop the language pack download. Packs already finished are kept." />
        <ProgressBar x:Name="OcrDownloadProgress" DockPanel.Dock="Right" Width="120" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="8,0"
                     AutomationProperties.Name="Language pack download progress" />
        <TextBlock x:Name="OcrStatusText" Classes="secondary" VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
    </StackPanel>
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="16">
      <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Timestamp server" />
      <TextBox AutomationProperties.Name="Timestamp server" x:Name="TimestampServerBox" Grid.Row="0" Grid.Column="1" PlaceholderText="Optional, for example http://timestamp.digicert.com" />
      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="secondary" TextWrapping="Wrap" Text="When signing with a certificate, a timestamp server records a trusted signing time, so the signature stays valid after the certificate expires. Only a fingerprint of the signature is sent." />
    </Grid>
    <Button x:Name="CloseButton" HorizontalAlignment="Right" Content="Close" IsDefault="True" IsCancel="True" />
  </StackPanel>
</Window>
