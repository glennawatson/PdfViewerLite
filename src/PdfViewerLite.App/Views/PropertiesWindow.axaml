<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PdfViewerLite.App.Views.PropertiesWindow"
        Width="560" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackground}">
  <StackPanel Margin="20" Spacing="16">
    <ItemsControl x:Name="EntryList" />
    <Button x:Name="CloseButton" HorizontalAlignment="Right" Content="Close" IsDefault="True" IsCancel="True" />
  </StackPanel>
</Window>
