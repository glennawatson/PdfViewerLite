<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PdfViewerLite.App.Views.PrintPreviewWindow"
        Title="Print" Width="1040" Height="720" MinWidth="760" MinHeight="480" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackground}">
  <!-- Modelled on a browser's print preview: the sheets that will print on the left, a few settings on the right. -->
  <Grid ColumnDefinitions="*,340">
    <ListBox x:Name="SheetList" Grid.Column="0" Classes="sheets" Background="{DynamicResource AppCanvasBackground}" Padding="0,16" />

    <Border Grid.Column="1" Background="{DynamicResource AppHeaderBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0">
      <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
          <TextBlock x:Name="SummaryText" DockPanel.Dock="Right" Classes="secondary" VerticalAlignment="Center" />
          <TextBlock Text="Print" FontSize="18" VerticalAlignment="Center" />
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" />
          <Button x:Name="PrintButton" Content="Print…" IsDefault="True" />
        </StackPanel>

        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="136,*">
            <TextBlock Text="Destination" VerticalAlignment="Center" />
            <ComboBox x:Name="DestinationBox" Grid.Column="1" HorizontalAlignment="Stretch" />
          </Grid>
          <Grid ColumnDefinitions="136,*">
            <TextBlock Text="Pages" VerticalAlignment="Center" />
            <ComboBox x:Name="PagesBox" Grid.Column="1" HorizontalAlignment="Stretch">
              <ComboBoxItem Content="All" />
              <ComboBoxItem Content="Current page" />
              <ComboBoxItem Content="Custom" />
            </ComboBox>
          </Grid>
          <Grid x:Name="CustomPagesRow" ColumnDefinitions="136,*">
            <TextBox x:Name="CustomPagesBox" Grid.Column="1" PlaceholderText="For example 1-3, 7" />
          </Grid>
          <Grid x:Name="CopiesRow" ColumnDefinitions="136,*">
            <TextBlock Text="Copies" VerticalAlignment="Center" />
            <NumericUpDown x:Name="CopiesBox" Grid.Column="1" Minimum="1" Maximum="999" Increment="1" FormatString="0" HorizontalAlignment="Stretch" />
          </Grid>
          <Grid x:Name="ColourRow" ColumnDefinitions="136,*">
            <TextBlock Text="Colour" VerticalAlignment="Center" />
            <ComboBox x:Name="ColourBox" Grid.Column="1" HorizontalAlignment="Stretch">
              <ComboBoxItem Content="Colour" />
              <ComboBoxItem Content="Black and white" />
            </ComboBox>
          </Grid>
          <Grid x:Name="SidesRow" ColumnDefinitions="136,*">
            <CheckBox x:Name="TwoSidedBox" Grid.Column="1" Content="Print on both sides" />
          </Grid>
          <Grid ColumnDefinitions="136,*">
            <TextBlock Text="Pages per sheet" VerticalAlignment="Center" />
            <ComboBox x:Name="PagesPerSheetBox" Grid.Column="1" HorizontalAlignment="Stretch" />
          </Grid>
          <Grid x:Name="PaperRow" ColumnDefinitions="136,*">
            <TextBlock Text="Paper size" VerticalAlignment="Center" />
            <ComboBox x:Name="PaperBox" Grid.Column="1" HorizontalAlignment="Stretch">
              <ComboBoxItem Content="A4" />
              <ComboBoxItem Content="Letter" />
            </ComboBox>
          </Grid>
          <Grid ColumnDefinitions="136,*">
            <TextBlock Text="Options" VerticalAlignment="Center" />
            <CheckBox x:Name="AnnotationsBox" Grid.Column="1" Content="Annotations" />
          </Grid>
          <TextBlock x:Name="PrinterHint" Classes="secondary" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="The printer, copies and paper are chosen in the next step." />
          <Button x:Name="SystemDialogButton" Classes="link" Margin="0,4,0,0" HorizontalAlignment="Left"
                  Content="Print using system dialog… (Ctrl+Shift+P)" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
