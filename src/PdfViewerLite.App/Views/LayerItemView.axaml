<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:PdfViewerLite.App.Views"
             x:Class="PdfViewerLite.App.Views.LayerItemView">
  <CheckBox x:Name="LayerBox" views:ControlHelp.Text="{x:Static views:Descriptions.Layer}" />
</UserControl>
