# Maintainer: Glenn Watson
# Builds from source. Release tags have no "v" prefix. Update pkgver and the
# archive hash for each release; the release workflow generates pdfviewerlite-bin.
pkgname=pdfviewerlite
pkgver=1.0.1
pkgrel=1
pkgdesc="Fast, tabbed PDF viewer that integrates with KDE Plasma and Dolphin"
arch=('x86_64' 'aarch64')
url="https://github.com/glennawatson/PdfViewerLite"
license=('MIT')
depends=('fontconfig' 'libx11' 'libice' 'libsm' 'gcc-libs' 'glibc')
optdepends=('wayland: native Wayland support' 'libxkbcommon: Wayland keyboard input' 'libegl: native Wayland rendering' 'libcups: print straight to a printer' 'tesseract: recognise text on scanned pages' 'tesseract-data-eng: English text recognition' 'libpulse: Read Aloud sound through PulseAudio or PipeWire')
# global.json pins the .NET 11 SDK.
makedepends=('dotnet-sdk>=11.0' 'clang' 'zlib')
conflicts=('pdfviewerlite-bin')
options=('!strip' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('14876a0bc415f308dcc539aa03f20ac5404c963e8db59dcf5ab2ab7f390cc3db')

_rid() {
  case "$CARCH" in
    x86_64) echo linux-x64 ;;
    aarch64) echo linux-arm64 ;;
  esac
}

build() {
  cd "PdfViewerLite-$pkgver"
  export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
  # The source archive has no Git history, so MinVer takes the version from pkgver.
  dotnet publish src/PdfViewerLite.App/PdfViewerLite.App.csproj -c Release -f net10.0 -r "$(_rid)" -o "$srcdir/publish" \
    -p:Version="$pkgver" -p:MinVerVersionOverride="$pkgver"
}

package() {
  cd "PdfViewerLite-$pkgver"
  install -Dm755 "$srcdir/publish/pdfviewerlite" "$pkgdir/usr/lib/pdfviewerlite/pdfviewerlite"
  for lib in "$srcdir"/publish/*.so; do
    install -Dm644 "$lib" "$pkgdir/usr/lib/pdfviewerlite/$(basename "$lib")"
  done
  install -d "$pkgdir/usr/bin"
  ln -s /usr/lib/pdfviewerlite/pdfviewerlite "$pkgdir/usr/bin/pdfviewerlite"
  install -Dm644 packaging/linux/net.glennwatson.PdfViewerLite.desktop "$pkgdir/usr/share/applications/net.glennwatson.PdfViewerLite.desktop"
  install -Dm644 packaging/linux/net.glennwatson.PdfViewerLite.metainfo.xml "$pkgdir/usr/share/metainfo/net.glennwatson.PdfViewerLite.metainfo.xml"
  install -d "$pkgdir/usr/share/icons/hicolor"
  cp -R packaging/linux/icons/hicolor/. "$pkgdir/usr/share/icons/hicolor/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
